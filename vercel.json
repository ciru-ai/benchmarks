{
  "headers": [
    {
      "source": "/research/amd-64-apps/apps/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "npu.ciru.ai"
        }
      ],
      "destination": "/npu/"
    },
    {
      "source": "/38gopher",
      "destination": "/api/gophermatch?selector=/"
    },
    {
      "source": "/38gopher/",
      "destination": "/api/gophermatch?selector=/"
    },
    {
      "source": "/38gopher/:path*",
      "destination": "/api/gophermatch?selector=/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/research",
      "destination": "/research/",
      "permanent": true
    },
    {
      "source": "/agentworld.html",
      "destination": "/research/agentworld.html",
      "permanent": true
    },
    {
      "source": "/atlas-vs-bf16-qwen36-27b.html",
      "destination": "/research/atlas-vs-bf16-qwen36-27b.html",
      "permanent": true
    },
    {
      "source": "/chadrock-rocmfp4-vs-unsloth-q4q6-mtp-nomtp-comparison-20260630.html",
      "destination": "/research/chadrock-rocmfp4-vs-unsloth-q4q6-mtp-nomtp-comparison-20260630.html",
      "permanent": true
    },
    {
      "source": "/hermes-tool-loop-findings.html",
      "destination": "/research/hermes-tool-loop-findings.html",
      "permanent": true
    },
    {
      "source": "/qwable-ultra-quality-761bpw-report-20260701.html",
      "destination": "/research/qwable-ultra-quality-761bpw-report-20260701.html",
      "permanent": true
    },
    {
      "source": "/rocmfp4-rocmfpx-speed-visual-report-2026-06-25.html",
      "destination": "/research/rocmfp4-rocmfpx-speed-visual-report-2026-06-25.html",
      "permanent": true
    },
    {
      "source": "/stepfun-tool-calling.html",
      "destination": "/research/stepfun-tool-calling.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bench.ciru.ai"
        }
      ],
      "destination": "https://llm.ciru.ai/:path*",
      "permanent": true
    }
  ]
}
